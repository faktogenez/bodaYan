{
  "name": "bodayan-launcher",
  "version": "1.1.0",
  "description": "bodaYan Launcher",
  "author": "bodaYan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2"
  },
  "build": {
    "appId": "com.bodayan.launcher",
    "productName": "bodaYan Launcher",
    "artifactName": "bodaYan-Launcher-${version}.${ext}",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "index.html",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      "config/config.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "bodaYan-Launcher-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  }
}
