{
  "name": "bodayan-launcher",
  "version": "1.1.0",
  "description": "bodaYan Launcher",
  "author": "bodaYan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/build-icons.js",
    "test": "node scripts/test-nickname-validation.js && node scripts/test-nickname-session.js && node scripts/test-renderer-auth.js && node scripts/test-self-update.js && node scripts/test-netsel.js",
    "test:nickname": "node scripts/test-nickname-validation.js && node scripts/test-nickname-session.js && node scripts/test-renderer-auth.js",
    "test:nickname-session": "node scripts/test-nickname-session.js",
    "test:self-update": "node scripts/test-self-update.js",
    "build:jre": "node scripts/build-jre.js",
    "manifest": "node scripts/gen-manifest.js",
    "publish:modpack": "node scripts/publish-modpack.js",
    "pack": "electron-builder --dir",
    "dist": "node scripts/build-jre.js && electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2"
  },
  "build": {
    "appId": "com.bodayan.launcher",
    "productName": "bodaYan Launcher",
    "artifactName": "bodaYan-Launcher.${ext}",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "index.html",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      "config/config.json",
      "jre",
      {
        "from": "launcher-visuals/config",
        "to": "launcher-visuals/config"
      },
      {
        "from": "launcher-visuals/backgrounds/optimized",
        "to": "launcher-visuals/backgrounds/optimized"
      },
      {
        "from": "launcher-visuals/logo/optimized",
        "to": "launcher-visuals/logo/optimized"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "bodaYan-Launcher-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "shortcutName": "bodaYan Launcher"
    },
    "mac": {
      "icon": "assets/icon.icns"
    },
    "linux": {
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "bodaYan-Launcher.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  }
}
