# Вывод сборки мода (mods-src/**/out, генерируется build.ps1, не коммитится)
mods-src/**/out/

# Логи и краш-дампы
logs/
*.log
*.log.gz
hs_err_pid*.log

# Локальные резервные копии
backups/
*.bak

